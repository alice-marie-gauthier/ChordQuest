# ChordQuest currently uses only the Python standard library, so there's no
# package config here — just the two variables app.py's run() accepts.
# Copy this file to .env and adjust if needed (there's no built-in .env
# loader; export these yourself or pass them inline, e.g.
# `CHORDQUEST_PORT=9000 python app.py`).

# Interface to bind to. Leave as 127.0.0.1 (loopback-only) for local runs;
# a hosting platform needs 0.0.0.0 to accept outside traffic — see
# render.yaml / Procfile / README.md's "Play from a phone or tablet".
CHORDQUEST_HOST=127.0.0.1

# TCP port to listen on. If unset, app.py also falls back to the platform-
# provided PORT variable (Render/Railway/Heroku-style hosts set this
# automatically), then to 8000.
CHORDQUEST_PORT=8000
